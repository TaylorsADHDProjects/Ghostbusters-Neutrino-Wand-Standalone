// Copies the right _Normal/_Afterlife constants into the active,
// plain-named variables used throughout the sketch. Called once at
// startup and again whenever the D12 switch changes.
void applyPackMode(bool useAfterlife) {
  afterlifeModeActive = useAfterlife;
  if (useAfterlife) {
    startupTrack = startupTrack_Afterlife;
    shutdownTrackCount = shutdownTrackCount_Afterlife;
    for (int i = 0; i < shutdownTrackCount_Afterlife; i++) shutdownTracks[i] = shutdownTracks_Afterlife[i];
    for (int i = 0; i < 8; i++) {
      modeIdleTrack[i] = modeIdleTrack_Afterlife[i];
      modeTrackHold[i] = modeTrackHold_Afterlife[i];
      modeTrackRelease[i] = modeTrackRelease_Afterlife[i];
    }
    overheatStartTrackNormal = overheatStartTrackNormal_Afterlife;
    overheatStartTrackBlue1 = overheatStartTrackBlue1_Afterlife;
    overheatStartTrackYellow1 = overheatStartTrackYellow1_Afterlife;
    overheatTrack38 = overheatTrack38_Afterlife;
    overheatTrack40 = overheatTrack40_Afterlife;
    blue = blue_Afterlife;
    orange = orange_Afterlife;
    green = green_Afterlife;
    yellow = yellow_Afterlife;
  } else {
    startupTrack = startupTrack_Normal;
    shutdownTrackCount = shutdownTrackCount_Normal;
    for (int i = 0; i < shutdownTrackCount_Normal; i++) shutdownTracks[i] = shutdownTracks_Normal[i];
    for (int i = 0; i < 8; i++) {
      modeIdleTrack[i] = modeIdleTrack_Normal[i];
      modeTrackHold[i] = modeTrackHold_Normal[i];
      modeTrackRelease[i] = modeTrackRelease_Normal[i];
    }
    overheatStartTrackNormal = overheatStartTrackNormal_Normal;
    overheatStartTrackBlue1 = overheatStartTrackBlue1_Normal;
    overheatStartTrackYellow1 = overheatStartTrackYellow1_Normal;
    overheatTrack38 = overheatTrack38_Normal;
    overheatTrack40 = overheatTrack40_Normal;
    blue = blue_Normal;
    orange = orange_Normal;
    green = green_Normal;
    yellow = yellow_Normal;
  }
}

// Send raw DFPlayer "play track" command
void playTrackRaw(int trackNum) {
  if (trackNum == 999 || trackNum == 0) return;  // skip placeholder tracks and "no tail"
  
  byte buffer[10] = {0x7E, 0xFF, 0x06, 0x03, 0x00, 0x00, (byte)trackNum, 0x00, 0x00, 0xEF};
  int checksum = -(buffer[1] + buffer[2] + buffer[3] + buffer[4] + buffer[5] + buffer[6]);
  buffer[7] = (checksum >> 8) & 0xFF;
  buffer[8] = checksum & 0xFF;
  
  for (int i = 0; i < 10; i++) {
    dfPlayerSerial.write(buffer[i]);
  }
}

// Send raw DFPlayer "loop track" command
void loopTrackRaw(int trackNum) {
  if (trackNum == 999 || trackNum == 0) return;
  
  byte buffer[10] = {0x7E, 0xFF, 0x06, 0x08, 0x00, 0x00, (byte)trackNum, 0x00, 0x00, 0xEF};
  int checksum = -(buffer[1] + buffer[2] + buffer[3] + buffer[4] + buffer[5] + buffer[6]);
  buffer[7] = (checksum >> 8) & 0xFF;
  buffer[8] = checksum & 0xFF;
  
  for (int i = 0; i < 10; i++) {
    dfPlayerSerial.write(buffer[i]);
  }
}

void setup() {
  Serial.begin(115200);
  Serial.println("Setup starting...");
  
  pinMode(ledPin, OUTPUT);
  pinMode(button1Pin, INPUT_PULLUP);
  pinMode(button2Pin, INPUT_PULLUP);
  pinMode(button3Pin, INPUT_PULLUP);
  pinMode(toggleSwitchPin, INPUT_PULLUP);
  pinMode(packModeSwitchPin, INPUT_PULLUP);  // switch to ground: LOW = Afterlife, HIGH (open) = Normal
  
  lastToggleState = digitalRead(toggleSwitchPin);
  toggleRawReading = lastToggleState;
  lastToggleDebounceTime = millis();
  
  lastPackModeSwitchState = digitalRead(packModeSwitchPin);
  packModeRawReading = lastPackModeSwitchState;
  applyPackMode(lastPackModeSwitchState == LOW);
  
  strip1.begin();
  strip1.setBrightness(50);
  strip1.show();
  
  strip2.begin();
  strip2.setBrightness(50);
  strip2.show();
  
  strip3.begin();
  strip3.setBrightness(50);
  strip3.show();
  
  dfPlayerSerial.begin(9600);
  
  delay(3000);  // give the DFPlayer time to be ready
  
  // Set volume to 20
  byte volBuffer[10] = {0x7E, 0xFF, 0x06, 0x06, 0x00, 0x00, 0x14, 0x00, 0x00, 0xEF};
  int volChecksum = -(volBuffer[1] + volBuffer[2] + volBuffer[3] + volBuffer[4] + volBuffer[5] + volBuffer[6]);
  volBuffer[7] = (volChecksum >> 8) & 0xFF;
  volBuffer[8] = volChecksum & 0xFF;
  for (int i = 0; i < 10; i++) {
    dfPlayerSerial.write(volBuffer[i]);
  }
  
  dfPlayerInitialized = true;
  Serial.println("DFPlayer ready!");
  
  lastCountUpdate = millis();
  lastStreamUpdate = millis();
  lastLedUpdate = millis();
  
  Serial.println("Setup complete!");
}

void loop() {
  // --- D12 pack mode switch, debounced ---
  int packModeRaw = digitalRead(packModeSwitchPin);
  if (packModeRaw != packModeRawReading) {
    lastPackModeDebounceTime = millis();
    packModeRawReading = packModeRaw;
  }
  if ((millis() - lastPackModeDebounceTime) > switchDebounceDelay && packModeRawReading != lastPackModeSwitchState) {
    lastPackModeSwitchState = packModeRawReading;
    applyPackMode(lastPackModeSwitchState == LOW);
    
    // If currently just sitting on the idle hum (and powered on),
    // restart it immediately on the new mode's idle track instead of
    // waiting for the old track's leftover timer to fire with a
    // mismatched track number.
    if (idleLoopActive && digitalRead(toggleSwitchPin) == LOW) {
      playTrackRaw(modeIdleTrack[firingMode]);
      idleLoopStartTime = millis();
    }
  }
  
  // --- D5 power toggle switch, debounced ---
  int toggleRaw = digitalRead(toggleSwitchPin);
  if (toggleRaw != toggleRawReading) {
    lastToggleDebounceTime = millis();
    toggleRawReading = toggleRaw;
  }
  bool toggleSwitchOn = (lastToggleState == LOW);
  
  if ((millis() - lastToggleDebounceTime) > switchDebounceDelay && toggleRawReading != lastToggleState) {
    lastToggleState = toggleRawReading;
    toggleSwitchOn = (lastToggleState == LOW);
    
    if (!toggleSwitchOn && dfPlayerInitialized) {
      // Switch turned OFF - play shutdown track
      idleLoopActive = false;
      randomSeed(analogRead(A0));
      int chosenShutdownTrack = shutdownTracks[random(0, shutdownTrackCount)];
      playTrackRaw(chosenShutdownTrack);
      delay(100);
      shutdownTrackPlayed = true;
      
      strip1.clear();
      strip2.clear();
      strip3.clear();
      strip1.show();
      strip2.show();
      strip3.show();
      digitalWrite(ledPin, LOW);
    } else if (toggleSwitchOn) {
      // Switch turned ON - reset state and play startup track
      shutdownTrackPlayed = false;
      track1Started = false;
      track3Started = false;
      overheatMode = false;
      burstFireActive = false;
      track6Playing = false;
      track4Playing = false;
      holdIntroPlaying = false;
      idleLoopActive = false;
      playingModeChangeSound = false;
      currentPixel = 0;
      countingUp = true;
      
      if (dfPlayerInitialized) {
        delay(100);
        playTrackRaw(startupTrack);
        track1Started = true;
        track1StartTime = millis();
      }
    }
  }
  
  // TOGGLE SWITCH ON - Normal operation
  if (toggleSwitchOn) {
    bool button1Pressed = digitalRead(button1Pin) == LOW;
    bool button2Pressed = digitalRead(button2Pin) == LOW;
    bool flowButtonPressed = button1Pressed || button2Pressed;
    
    // Play startup track once if the switch was already on at boot
    if (!track1Started && dfPlayerInitialized) {
      delay(100);
      playTrackRaw(startupTrack);
      track1Started = true;
      track1StartTime = millis();
    }
    
    // Transition to idle track after the startup track finishes
    if (track1Started && !track3Started && (millis() - track1StartTime >= track1Duration)) {
      if (modeIdleTrack[firingMode] != 999) {
        playTrackRaw(modeIdleTrack[firingMode]);
        idleLoopActive = true;
        idleLoopStartTime = millis();
      }
      track3Started = true;
    }
    
    // Return to idle track after the release-tail track finishes
    if (track4Playing && (millis() - track4StartTime >= track4Duration)) {
      if (modeIdleTrack[firingMode] != 999 && !playingModeChangeSound) {
        playTrackRaw(modeIdleTrack[firingMode]);
        idleLoopActive = true;
        idleLoopStartTime = millis();
      }
      track4Playing = false;
    }
    
    // Mode-change transition sound sequence (only used under MODE_CHANGE_STYLE_EFFECT)
    if (playingModeChangeSound) {
      unsigned long elapsed = millis() - modeChangeSoundStartTime;
      
      if (pendingSecondTrack != 0 && !firstModeTrackPlayed && elapsed >= modeChangeFirstTrackDuration) {
        playTrackRaw(pendingSecondTrack);
        firstModeTrackPlayed = true;
      }
      
      unsigned long totalDuration = (pendingSecondTrack != 0)
        ? (modeChangeFirstTrackDuration + modeChangeSecondTrackDuration)
        : modeChangeFirstTrackDuration;
      if (elapsed >= totalDuration) {
        playingModeChangeSound = false;
        firstModeTrackPlayed = false;
        pendingSecondTrack = 0;
        
        if (modeIdleTrack[firingMode] != 999 && !overheatMode) {
          playTrackRaw(modeIdleTrack[firingMode]);
          idleLoopActive = true;
          idleLoopStartTime = millis();
        }
      }
    }
    
    // Button press/release - firing sounds
    if (flowButtonPressed && !lastFlowButtonState && !overheatMode && !playingModeChangeSound) {
      if (firingMode == 1 || firingMode == 3 || firingMode == 5 || firingMode == 7) {
        // Burst modes
        playTrackRaw(modeTrackHold[firingMode]);
        burstFireActive = true;
        burstFireStartTime = millis();
        if (firingMode == 1) {
          burstFireDuration = 3000;
        } else if (firingMode == 5 || firingMode == 7) {
          burstFireDuration = 2000;
        } else {
          burstFireDuration = 1000;
        }
        track6Playing = true;
        track4Playing = false;
      }
      else if (holdIntroTrack[firingMode] != 0) {
        // Continuous-fire modes with an intro track
        playTrackRaw(holdIntroTrack[firingMode]);
        holdIntroPlaying = true;
        holdIntroStartTime = millis();
        holdIntroActiveDuration = holdIntroDuration[firingMode];
        track6Playing = true;
        track4Playing = false;
      }
      else {
        playTrackRaw(modeTrackHold[firingMode]);
        track6Playing = true;
        track4Playing = false;
      }
    } else if (!flowButtonPressed && lastFlowButtonState && !overheatMode && track6Playing && !playingModeChangeSound) {
      // Button release - continuous-fire modes only
      if (firingMode != 1 && firingMode != 3 && firingMode != 5 && firingMode != 7) {
        holdIntroPlaying = false;
        unsigned long holdTimeAtRelease = millis() - buttonHoldStartTime;
        
        if (nearOverheatTailTrack[firingMode] != 0 && holdTimeAtRelease >= nearOverheatThreshold[firingMode]) {
          playTrackRaw(nearOverheatTailTrack[firingMode]);
          track4Playing = true;
          track4StartTime = millis();
        }
        else if (modeReleaseTrackCount[firingMode] > 0) {
          randomSeed(analogRead(A0));
          int chosenReleaseTrack = modeReleaseTracks[firingMode][random(0, modeReleaseTrackCount[firingMode])];
          playTrackRaw(chosenReleaseTrack);
          track4Playing = true;
          track4StartTime = millis();
        }
        else if (modeTrackRelease[firingMode] != 0) {
          playTrackRaw(modeTrackRelease[firingMode]);
          track4Playing = true;
          track4StartTime = millis();
        } else {
          if (modeIdleTrack[firingMode] != 999) {
            playTrackRaw(modeIdleTrack[firingMode]);
            idleLoopActive = true;
            idleLoopStartTime = millis();
          }
        }
        track6Playing = false;
      }
    }
    
    // Hold intro -> loop transition
    if (holdIntroPlaying && (millis() - holdIntroStartTime >= holdIntroActiveDuration)) {
      holdIntroPlaying = false;
      if (flowButtonPressed && !overheatMode && holdLoopTrack[firingMode] != 0) {
        loopTrackRaw(holdLoopTrack[firingMode]);
      }
    }
    
    // Idle hum manual re-loop
    if (idleLoopActive && (millis() - idleLoopStartTime >= idleTrackDuration[firingMode])) {
      if (modeIdleTrack[firingMode] != 999 && !overheatMode && !flowButtonPressed
          && !holdIntroPlaying && !playingModeChangeSound && !track4Playing) {
        playTrackRaw(modeIdleTrack[firingMode]);
        idleLoopStartTime = millis();
      } else {
        idleLoopActive = false;
      }
    }
    
    // Burst fire completion
    if (burstFireActive && (millis() - burstFireStartTime >= burstFireDuration)) {
      burstFireActive = false;
      track6Playing = false;
      
      if (modeIdleTrack[firingMode] != 999 && !playingModeChangeSound) {
        playTrackRaw(modeIdleTrack[firingMode]);
        idleLoopActive = true;
        idleLoopStartTime = millis();
      }
    }
    
    lastFlowButtonState = flowButtonPressed;
    
    // Track button hold time for overheat trigger
    if (!overheatMode) {
      if (flowButtonPressed) {
        if (!buttonWasPressed) {
          buttonHoldStartTime = millis();
          buttonWasPressed = true;
        } else {
          unsigned long holdTime = millis() - buttonHoldStartTime;
          
          if (holdTime >= holdThreshold) {
            overheatMode = true;
            overheatStartTime = millis();
            overheatMusicStartTime = millis();
            
            int overheatStartTrack = overheatStartTrackNormal;
            if (firingMode == 4) overheatStartTrack = overheatStartTrackBlue1;
            else if (firingMode == 6) overheatStartTrack = overheatStartTrackYellow1;
            else if (firingMode == 2) overheatStartTrack = 0;  // Green 1: no start sound
            
            if (overheatStartTrack != 0) {
              playTrackRaw(overheatStartTrack);
              track5Playing = true;
              track38Playing = false;
              overheatTrack38TriggerElapsed = track5Duration;
            } else {
              playTrackRaw(overheatTrack38);
              track5Playing = false;
              track38Playing = true;
              overheatTrack38TriggerElapsed = 0;
            }
            track40Playing = false;
            overheatTrack40TriggerElapsed = overheatTrack38TriggerElapsed + track38Duration;
          }
        }
      } else {
        buttonWasPressed = false;
      }
    }
    
    // Overheat music sequence
    if (overheatMode) {
      unsigned long elapsedMusic = millis() - overheatMusicStartTime;
      
      if (track5Playing && elapsedMusic >= overheatTrack38TriggerElapsed) {
        playTrackRaw(overheatTrack38);
        track5Playing = false;
        track38Playing = true;
      }
      
      if (track38Playing && elapsedMusic >= overheatTrack40TriggerElapsed) {
        playTrackRaw(overheatTrack40);
        track38Playing = false;
        track40Playing = true;
      }
    }
    
    // End overheat mode
    if (overheatMode && (millis() - overheatStartTime >= overheatDuration)) {
      overheatMode = false;
      track5Playing = false;
      track38Playing = false;
      track40Playing = false;
      currentPixel = 0;
      countingUp = true;
      if (modeIdleTrack[firingMode] != 999) {
        playTrackRaw(modeIdleTrack[firingMode]);
        idleLoopActive = true;
        idleLoopStartTime = millis();
      }
    }
    
    // LED blink speed - 3x faster in overheat mode
    int currentLedBlinkSpeed = overheatMode ? (ledBlinkSpeed / 3) : ledBlinkSpeed;
    
    if (millis() - lastLedUpdate >= currentLedBlinkSpeed) {
      lastLedUpdate = millis();
      ledState = !ledState;
      digitalWrite(ledPin, ledState ? HIGH : LOW);
    }
    
    // Button 3 cycles through 8 firing modes, debounced
    int button3Raw = digitalRead(button3Pin);
    if (button3Raw != button3RawReading) {
      lastButton3DebounceTime = millis();
      button3RawReading = button3Raw;
    }
    if ((millis() - lastButton3DebounceTime) > switchDebounceDelay && button3RawReading != button3LastState) {
      bool wasHigh = (button3LastState == HIGH);
      button3LastState = button3RawReading;
      
      if (wasHigh && button3LastState == LOW && dfPlayerInitialized) {
        int previousMode = firingMode;
        firingMode++;
        if (firingMode > 7) {
          firingMode = 0;
        }
        
#if MODE_CHANGE_STYLE == MODE_CHANGE_STYLE_EFFECT
        if (previousMode == 1 && firingMode == 2) {
          playTrackRaw(40);
          playingModeChangeSound = true;
          modeChangeSoundStartTime = millis();
          pendingSecondTrack = 0;
          firstModeTrackPlayed = false;
          modeChangeFirstTrackDuration = modeChangeDuration_NormalToGreen;
          modeChangeSecondTrackDuration = 0;
        }
        else if (previousMode == 3 && firingMode == 4) {
          playTrackRaw(41);
          playingModeChangeSound = true;
          modeChangeSoundStartTime = millis();
          pendingSecondTrack = 42;
          firstModeTrackPlayed = false;
          modeChangeFirstTrackDuration = modeChangeDuration_GreenToBlue_First;
          modeChangeSecondTrackDuration = modeChangeDuration_GreenToBlue_Second;
        }
        else if (previousMode == 5 && firingMode == 6) {
          playTrackRaw(43);
          playingModeChangeSound = true;
          modeChangeSoundStartTime = millis();
          pendingSecondTrack = 44;
          firstModeTrackPlayed = false;
          modeChangeFirstTrackDuration = modeChangeDuration_BlueToYellow_First;
          modeChangeSecondTrackDuration = modeChangeDuration_BlueToYellow_Second;
        }
        else if (previousMode == 7 && firingMode == 0) {
          playTrackRaw(45);
          playingModeChangeSound = true;
          modeChangeSoundStartTime = millis();
          pendingSecondTrack = 0;
          firstModeTrackPlayed = false;
          modeChangeFirstTrackDuration = modeChangeDuration_YellowToNormal;
          modeChangeSecondTrackDuration = 0;
        }
        else if (modeIdleTrack[firingMode] != 999 && !overheatMode) {
          playTrackRaw(modeIdleTrack[firingMode]);
          idleLoopActive = true;
          idleLoopStartTime = millis();
        }
#else
        if (modeIdleTrack[firingMode] != 999 && !overheatMode) {
          playTrackRaw(modeIdleTrack[firingMode]);
          idleLoopActive = true;
          idleLoopStartTime = millis();
        }
#endif
        
        lastFiringMode = firingMode;
      }
    }
    
    // Strip 1 - hold-time indicator / overheat countdown
    if (flowButtonPressed && buttonWasPressed && !overheatMode) {
      unsigned long holdTime = millis() - buttonHoldStartTime;
      
      uint32_t strip1Color;
      if (firingMode == 0 || firingMode == 1) {
        strip1Color = strip1.Color(255, 0, 0);
      } else if (firingMode == 2 || firingMode == 3) {
        strip1Color = green;
      } else if (firingMode == 4 || firingMode == 5) {
        strip1Color = blue;
      } else {
        strip1Color = yellow;
      }
      
      if (holdTime < ledBuildupDuration) {
        // Build up from empty to full over ledBuildupDuration
        int segmentsLit = map(holdTime, 0, ledBuildupDuration, 1, numPixels1);
        if (segmentsLit > numPixels1) segmentsLit = numPixels1;
        
        strip1.clear();
        for (int i = 0; i < segmentsLit; i++) {
          strip1.setPixelColor(i, strip1Color);
        }
        strip1.show();
      } else {
        // Past ledBuildupDuration but not yet overheated - flash as a warning
        static unsigned long lastPreOverheatBlinkTime = 0;
        static bool preOverheatBlinkState = false;
        if (millis() - lastPreOverheatBlinkTime >= ledBlinkSpeed) {
          lastPreOverheatBlinkTime = millis();
          preOverheatBlinkState = !preOverheatBlinkState;
        }
        
        strip1.clear();
        if (preOverheatBlinkState) {
          for (int i = 0; i < numPixels1; i++) {
            strip1.setPixelColor(i, strip1Color);
          }
        }
        strip1.show();
      }
      
    } else if (overheatMode) {
      // Overheat mode - blinking countdown over overheatDuration
      unsigned long elapsedOverheat = millis() - overheatStartTime;
      int targetPixel = 4 - (elapsedOverheat / 2200);
      if (targetPixel < 0) targetPixel = 0;
      
      static unsigned long lastBlinkTime = 0;
      static bool blinkState = false;
      if (millis() - lastBlinkTime >= 150) {
        lastBlinkTime = millis();
        blinkState = !blinkState;
      }
      
      strip1.clear();
      if (blinkState) {
        uint32_t strip1Color;
        if (firingMode == 0 || firingMode == 1) {
          strip1Color = strip1.Color(255, 0, 0);
        } else if (firingMode == 2 || firingMode == 3) {
          strip1Color = green;
        } else if (firingMode == 4 || firingMode == 5) {
          strip1Color = blue;
        } else {
          strip1Color = yellow;
        }
        
        for (int i = 0; i <= targetPixel; i++) {
          strip1.setPixelColor(i, strip1Color);
        }
      }
      strip1.show();
      
    } else {
      // Idle animation
      if (millis() - lastCountUpdate >= countSpeed) {
        lastCountUpdate = millis();
        
        strip1.clear();
        
        uint32_t strip1Color;
        if (firingMode == 0 || firingMode == 1) {
          strip1Color = strip1.Color(255, 0, 0);
        } else if (firingMode == 2 || firingMode == 3) {
          strip1Color = green;
        } else if (firingMode == 4 || firingMode == 5) {
          strip1Color = blue;
        } else {
          strip1Color = yellow;
        }
        
        for (int i = 0; i <= currentPixel; i++) {
          strip1.setPixelColor(i, strip1Color);
        }
        strip1.show();
        
        if (countingUp) {
          currentPixel++;
          if (currentPixel >= numPixels1 - 1) {
            countingUp = false;
          }
        } else {
          currentPixel--;
          if (currentPixel <= 0) {
            countingUp = true;
          }
        }
      }
    }
    
    // Strips 2 and 3 - streaming effect while firing
    bool shouldStream = false;
    int currentStreamSpeed;
    
    if (firingMode == 1 || firingMode == 3 || firingMode == 5 || firingMode == 7) {
      shouldStream = burstFireActive && (millis() - burstFireStartTime < burstLightDuration);
      currentStreamSpeed = burstStreamSpeed;
    } else {
      shouldStream = flowButtonPressed && !overheatMode;
      currentStreamSpeed = continuousStreamSpeed;
    }
    
    if (shouldStream) {
      if (millis() - lastStreamUpdate >= currentStreamSpeed) {
        lastStreamUpdate = millis();
        
        uint32_t baseColor;
        if (firingMode == 0 || firingMode == 1) {
          baseColor = 0;  // Normal mode uses its own orange/blue pattern below
        } else if (firingMode == 2 || firingMode == 3) {
          baseColor = green;
        } else if (firingMode == 4 || firingMode == 5) {
          baseColor = blue;
        } else {
          baseColor = yellow;
        }
        
        for (int i = 0; i < numPixels2; i++) {
          uint32_t color;
          
          if (firingMode == 0 || firingMode == 1) {
            int colorIndex = (i + streamPosition) % 4;
            int brightIndex = (i + streamPosition) % 8;
            
            float brightness;
            if (brightIndex < 2) {
              brightness = 1.0;
            } else if (brightIndex < 4) {
              brightness = 0.6;
            } else if (brightIndex < 6) {
              brightness = 0.3;
            } else {
              brightness = 0.1;
            }
            
            if (colorIndex < 2) {
              color = strip2.Color(0, 0, 255 * brightness);
            } else {
              color = strip2.Color(255 * brightness, 100 * brightness, 0);
            }
          } else {
            int brightIndex = (i + streamPosition) % 8;
            float brightness;
            
            if (brightIndex < 2) {
              brightness = 1.0;
            } else if (brightIndex < 4) {
              brightness = 0.6;
            } else if (brightIndex < 6) {
              brightness = 0.3;
            } else {
              brightness = 0.1;
            }
            
            uint8_t r = (baseColor >> 16) & 0xFF;
            uint8_t g = (baseColor >> 8) & 0xFF;
            uint8_t b = baseColor & 0xFF;
            
            color = strip2.Color(r * brightness, g * brightness, b * brightness);
          }
          
          strip2.setPixelColor(i, color);
          strip3.setPixelColor(i, color);
        }
        
        strip2.show();
        strip3.show();
        
        streamPosition--;
        if (streamPosition < 0) {
          streamPosition = (firingMode == 0 || firingMode == 1) ? 3 : 7;
        }
      }
    } else {
      strip2.clear();
      strip3.clear();
      strip2.show();
      strip3.show();
      streamPosition = 0;
    }
  }
  // TOGGLE SWITCH OFF - shutdown state, LEDs stay off until switch is turned back on
}
